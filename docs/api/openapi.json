{
  "components": {
    "schemas": {
      "Body_submit_demo_login": {
        "properties": {
          "next_url": {
            "default": "/catalog",
            "title": "Next Url",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Body_submit_demo_login",
        "type": "object"
      },
      "CatalogItem": {
        "properties": {
          "id": {
            "description": "Stable deterministic item identifier.",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Deterministic display name for the item.",
            "title": "Name",
            "type": "string"
          },
          "price": {
            "description": "Deterministic item price.",
            "title": "Price",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "price"
        ],
        "title": "CatalogItem",
        "type": "object"
      },
      "CatalogPage": {
        "properties": {
          "attempt": {
            "description": "One-based request attempt for this run, scenario, and page.",
            "title": "Attempt",
            "type": "integer"
          },
          "items": {
            "description": "Items for the requested page.",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "One-based page that produced this response.",
            "title": "Page",
            "type": "integer"
          },
          "scenario": {
            "description": "Resolved scenario name.",
            "enum": [
              "success",
              "transient",
              "permanent",
              "slow",
              "resume",
              "dom-change",
              "duplicates"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "total_pages": {
            "description": "Total pages exposed by the scenario.",
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "total_pages",
          "items",
          "scenario",
          "attempt"
        ],
        "title": "CatalogPage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Resilient Browser Automation Test Stand",
    "version": "1.0.0rc1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/reset": {
      "post": {
        "description": "Test-only operation that clears all in-memory request-attempt counters.",
        "operationId": "reset_attempt_counters",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Reset Attempt Counters",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset deterministic attempt counters"
      }
    },
    "/api/catalog": {
      "get": {
        "description": "Returns deterministic catalog data for retry, pagination, duplicate, delay, and checkpoint-recovery tests.",
        "operationId": "get_catalog_page",
        "parameters": [
          {
            "description": "One-based catalog page to fetch.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "One-based catalog page to fetch.",
              "maximum": 20,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Scenario to execute; inherits the active preset when omitted.",
            "in": "query",
            "name": "scenario",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "success",
                    "transient",
                    "permanent",
                    "slow",
                    "resume",
                    "dom-change",
                    "duplicates"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Scenario to execute; inherits the active preset when omitted.",
              "title": "Scenario"
            }
          },
          {
            "description": "Opaque key that isolates deterministic attempt counters between test runs.",
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "default": "manual",
              "description": "Opaque key that isolates deterministic attempt counters between test runs.",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "description": "Initial transient failures per page.",
            "in": "query",
            "name": "fail_for",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Initial transient failures per page.",
              "title": "Fail For"
            }
          },
          {
            "description": "Response delay for the slow scenario, in milliseconds.",
            "in": "query",
            "name": "delay_ms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Response delay for the slow scenario, in milliseconds.",
              "title": "Delay Ms"
            }
          },
          {
            "description": "Delay before each transient 503 response, in milliseconds.",
            "in": "query",
            "name": "failure_delay_ms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Delay before each transient 503 response, in milliseconds.",
              "title": "Failure Delay Ms"
            }
          },
          {
            "description": "Permanently failing page in the resume scenario.",
            "in": "query",
            "name": "fail_page",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Permanently failing page in the resume scenario.",
              "title": "Fail Page"
            }
          },
          {
            "description": "Number of pages exposed by the catalog.",
            "in": "query",
            "name": "total_pages",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Number of pages exposed by the catalog.",
              "title": "Total Pages"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "Permanent or checkpoint-resume scenario failure."
          },
          "503": {
            "description": "Transient scenario failure; includes the Retry-After header."
          }
        },
        "summary": "Fetch one deterministic catalog page"
      }
    },
    "/catalog": {
      "get": {
        "description": "Renders a JavaScript catalog UI. Protected scenarios redirect to the demo login form. Use stable data-testid locators when automating this page.",
        "operationId": "get_catalog_shell",
        "parameters": [
          {
            "description": "Scenario to execute; inherits the active preset when omitted.",
            "in": "query",
            "name": "scenario",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "success",
                    "transient",
                    "permanent",
                    "slow",
                    "resume",
                    "dom-change",
                    "duplicates"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Scenario to execute; inherits the active preset when omitted.",
              "title": "Scenario"
            }
          },
          {
            "description": "Opaque key that isolates deterministic attempt counters between test runs.",
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "default": "manual",
              "description": "Opaque key that isolates deterministic attempt counters between test runs.",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "description": "Initial transient failures per page.",
            "in": "query",
            "name": "fail_for",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Initial transient failures per page.",
              "title": "Fail For"
            }
          },
          {
            "description": "Response delay for the slow scenario, in milliseconds.",
            "in": "query",
            "name": "delay_ms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Response delay for the slow scenario, in milliseconds.",
              "title": "Delay Ms"
            }
          },
          {
            "description": "Delay before each transient 503 response, in milliseconds.",
            "in": "query",
            "name": "failure_delay_ms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Delay before each transient 503 response, in milliseconds.",
              "title": "Failure Delay Ms"
            }
          },
          {
            "description": "Permanently failing page in the resume scenario.",
            "in": "query",
            "name": "fail_page",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Permanently failing page in the resume scenario.",
              "title": "Fail Page"
            }
          },
          {
            "description": "Number of pages exposed by the catalog.",
            "in": "query",
            "name": "total_pages",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Number of pages exposed by the catalog.",
              "title": "Total Pages"
            }
          },
          {
            "description": "Require the fixed demo login before serving the catalog shell.",
            "in": "query",
            "name": "protected",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Require the fixed demo login before serving the catalog shell.",
              "title": "Protected"
            }
          },
          {
            "in": "cookie",
            "name": "demo_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Demo Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "303": {
            "description": "Protected catalog redirects to the demo login form."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Render the browser catalog shell"
      }
    },
    "/health": {
      "get": {
        "description": "Returns a deterministic readiness response for container and service checks.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check service health"
      }
    },
    "/login": {
      "get": {
        "description": "Renders the fixed-credential form used only by protected catalog scenarios.",
        "operationId": "get_demo_login_form",
        "parameters": [
          {
            "in": "query",
            "name": "next_url",
            "required": false,
            "schema": {
              "default": "/catalog",
              "title": "Next Url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Render the demo login form"
      },
      "post": {
        "description": "Accepts the fixed demo credentials and redirects to a local catalog URL.",
        "operationId": "submit_demo_login",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_demo_login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "303": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "The supplied demo credentials are invalid."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authenticate to a protected demo catalog"
      }
    }
  }
}
